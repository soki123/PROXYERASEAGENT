# Copy to .env or export these variables in your shell.
# The scripts intentionally contain no machine-specific absolute paths.
export PYTHON_BIN=python3

# External watermark model implementations and checkpoints.
export WATERMARK_MODELS_ROOT=/path/to/watermark-models
export ENCODER_CLASSIFI_ROOT=/path/to/encoder_classifi

# Input/output data.
export DATA_ROOT=/path/to/encoder_residual_stats_500
export WATERMARKED_IMAGE=/path/to/encoded.png
export TRUE_DECODER=cin
export OUTPUT_DIR=outputs/single
export OUTPUT_ROOT=outputs/batch
export DEVICE=cuda

# Final GradNorm profile used by the paper's low-frequency experiment.
export ADVERSARIAL_GRADNORM_QUALITY_SCALE=180
export ADVERSARIAL_WATERMARK_WEIGHT=10
